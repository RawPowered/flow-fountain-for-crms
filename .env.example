# Local-first configuration. Copy to .env, then run npm start and open /install.
# No credentials, installation identity, targets, or external integrations ship here.
HOST=127.0.0.1
PORT=3000
LOCAL_DEVELOPMENT=true
NODE_ENV=development
TRUST_PROXY=0
COOKIE_SECURE=false

# The installer writes these using your supplied database and generated keys.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SESSION_SECRET=
SECRET_BOX_KEY=
FORENSIC_KEY=
ADMIN_BASE_PATH=
INSTANCE_ID=
PUBLIC_API_BASE_PATH=
WEBHOOK_BASE_PATH=
HEALTH_PATH=
API_KEY_PREFIX=
AUTOMATION_NAMESPACE=
SESSION_COOKIE_NAME=
OPERATOR_COOKIE_NAME=
API_DISPLAY_NAME=
API_METADATA_HEADERS_ENABLED=false
API_METADATA_HEADER_PREFIX=
ALLOW_REINSTALL=false
ADMIN_IP_ALLOWLIST=
CORS_ORIGINS=
CORS_ALLOW_ALL=false
HEALTH_PUBLIC=true

# Optional custom CRM adapters. Exact HTTPS origins only; no wildcard domains.
CRM_APP_ORIGIN=
CRM_ALLOWED_ORIGINS=
CRM_ASSIGNED_DIALER_FIELD_ID=
CRM_ALTERNATIVE_PHONE_FIELD_ID=
CRM_PHONE_3_FIELD_ID=
CUSTOM_CRM_PROXY_ENABLED=false
CUSTOM_CRM_BASE_URL=
CUSTOM_CRM_AUTHORIZATION=
CUSTOM_CRM_ALLOW_CLIENT_AUTH=false
CUSTOM_CRM_ALLOWED_PATHS=/backend
CUSTOM_CRM_TIMEOUT_MS=15000

# Optional integrations: configure after installation, then restart.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ALLOWED_EMAILS=
ADMIN_MFA_SESSION_HOURS=12
DNC_SCRUB_KEY=
DNC_SCRUB_PROJECT_ID=
DNC_SCRUB_CAMPAIGN_ID=
DNC_SCRUB_TIMEOUT_MS=30000
DNC_SCRUB_BATCH_SIZE=50
DNC_SCRUB_MAX_RETRIES=2
DNC_SCRUB_REQUESTS_PER_MINUTE=30
CENSUS_API_KEY=
CENSUS_DATA_YEAR=2024
HAWK_CODE_RUNNER_URL=
HAWK_CODE_RUNNER_TOKEN=
HAWK_CODE_RUNNER_TIMEOUT_MS=5000

# Optional Python bridge. Blank URL/token disables it.
PARROT_BASE_URL=
PARROT_SERVICE_TOKEN=
PARROT_TIMEOUT_MS=15000
PARROT_MAX_SOURCE_BYTES=65536
PARROT_RECON_ALLOWED_HOSTS=
PARROT_RECON_ALLOW_HTTP=false
PARROT_RECON_MAX_BYTES=262144

# Local evidence storage is created at runtime and excluded from releases.
PRESERVATION_WORKER_ENABLED=true
PRESERVATION_STAGING_ROOT=
PRESERVATION_WORKER_POLL_MS=15000
PRESERVATION_CHUNK_SIZE=500
PRESERVATION_MAX_RECORDS=1000000
PRESERVATION_MAX_ARTIFACT_BYTES=1073741824
PRESERVATION_MAX_ATTEMPTS=3
SENTINEL_RETENTION_DAYS=30
SENTINEL_FORENSICS_ENABLED=true
SENTINEL_FORENSIC_RETENTION_DAYS=7
SENTINEL_FORENSIC_MAX_BODY_BYTES=24576
